@page "/"

<div class="w-full px-6 py-12">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-start gap-8">
        <div class="lg:flex-1">
            <h1 class="text-4xl font-extrabold mb-3">METASYNAPSE</h1>
            <p class="text-xl text-slate-700 mb-6">Smart orchestration for reliable, secure conversational AI.</p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="flex flex-col items-start gap-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-cyan-600">
                        <path d="M3 7v10a2 2 0 0 0 2 2h14"></path>
                        <path d="M17 7V5a2 2 0 0 0-2-2H9"></path>
                        <path d="M7 11h10"></path>
                    </svg>
                    <div class="font-semibold">Orchestrate</div>
                    <div class="text-sm text-slate-600">Route messages to topic agents and plugins.</div>
                </div>

                <div class="flex flex-col items-start gap-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-amber-600">
                        <rect x="3" y="7" width="18" height="13" rx="2"></rect>
                        <path d="M7 7V4a2 2 0 0 1 2-2h6"></path>
                    </svg>
                    <div class="font-semibold">Secure</div>
                    <div class="text-sm text-slate-600">PII masking, GDPR-aware controls, and audit trails.</div>
                </div>

                <div class="flex flex-col items-start gap-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-green-600">
                        <path d="M12 3v12"></path>
                        <path d="M8 7h8"></path>
                        <path d="M5 21h14"></path>
                    </svg>
                    <div class="font-semibold">Deploy</div>
                    <div class="text-sm text-slate-600">Fast, configuration-driven agent publishing.</div>
                </div>
            </div>

            <div class="mt-8 flex gap-3">
                <a class="inline-flex items-center gap-2 bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-500" href="/chat">Open Chat</a>
                <a class="inline-flex items-center gap-2 border border-slate-200 px-4 py-2 rounded-lg hover:bg-slate-50" href="/agent-designer">Agent Designer</a>
            </div>
        </div>

        <div class="lg:w-1/3 bg-slate-50 rounded-xl p-4">
            <h3 class="font-semibold mb-2">Quick Start</h3>
            <ol class="list-decimal pl-5 text-slate-700">
                <li>Open Chat → send a message.</li>
                <li>Attach docs in Session to enable semantic memory.</li>
                <li>Use Agent Designer to tweak and publish agents quickly.</li>
            </ol>

            <p class="mt-4 text-xs text-slate-500">Accessible, auditable, and configurable for enterprise governance.</p>
        </div>
    </div>
</div>

